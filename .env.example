# SKE Export Documents & Realisation Tracker - Environment Configuration Template
# Strictly self-hosted: Zero external cloud APIs, zero AI API keys required.

NODE_ENV=production
PORT=3000

# PostgreSQL Connection String
DATABASE_URL=postgresql://ske_user:ske_secure_password_2026@localhost:5432/ske_export_db?schema=public
POSTGRES_USER=ske_user
POSTGRES_PASSWORD=ske_secure_password_2026
POSTGRES_DB=ske_export_db

# Security & Authentication
JWT_SECRET=replace_with_64_character_random_hex_string_on_vps

# Server-side Local OCR & Queue Configuration
OCR_CONCURRENCY=2
MAX_OCR_FILE_SIZE_MB=50

# Private Storage Directory
STORAGE_ROOT=/app/storage