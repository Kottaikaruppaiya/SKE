# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SKE Export Tracker VPS Configuration
DATABASE_URL="postgresql://ske_user:ske_password@localhost:5432/ske_export_db?schema=public"
JWT_SECRET="replace_with_secure_random_production_secret"
PORT="3000"
